PORT=3000
# AI Provider selection: 'openai' or 'gemini'
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-terra
# USE_ASSISTANTS_API=true # Set to true to use Assistants API, otherwise it uses standard chat completions with function calling for search
# SERP_API_KEY=your_serp_api_key_here # Optional: For third party SERP API if needed

# Gemini Configuration (Google Search Grounding enabled natively)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
